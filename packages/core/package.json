{
  "name": "prettymaids",
  "version": "0.1.0",
  "description": "Prettier Mermaid diagrams: modern themes and SVG post-processing",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "mermaid": ">=11"
  },
  "devDependencies": {
    "mermaid": "^12.3.0"
  },
  "author": "Pravin Paratey",
  "homepage": "https://github.com/pravin/prettymaids#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pravin/prettymaids.git"
  },
  "bugs": {
    "url": "https://github.com/pravin/prettymaids/issues"
  },
  "keywords": [
    "mermaid",
    "diagram",
    "diagrams",
    "theme",
    "svg",
    "flowchart",
    "mindmap",
    "visualization",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
