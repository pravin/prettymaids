erDiagram
    CUSTOMER ||--o{ ORDER : places
    ORDER ||--|{ LINE_ITEM : contains
    PRODUCT ||--o{ LINE_ITEM : "appears in"
    CUSTOMER {
        int id PK
        string name
        string email
    }
    ORDER {
        int id PK
        date placed_at
        int customer_id FK
    }
    PRODUCT {
        int id PK
        string title
        float price
    }
    LINE_ITEM {
        int order_id FK
        int product_id FK
        int quantity
    }
